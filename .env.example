# Copiar a .env y rellenar. Generar secretos con:
#   openssl rand -hex 32  (JWT/SESSION, mínimo 32 chars)
#   openssl rand -hex 32  (MICROSOFT_CRYPTO_KEY: 32 bytes = 64 hex)
# NUNCA commitear .env real.

# --- Postgres dedicado del stack ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=CAMBIAR-postgres-fuerte
POSTGRES_DB=crm

# --- Servicios internos ---
REDIS_PASSWORD=CAMBIAR-redis-fuerte
MINIO_USER=crm
MINIO_PASSWORD=CAMBIAR-minio-fuerte-min-8-chars

# --- App (producción exige los 4 secretos) ---
JWT_SECRET=CAMBIAR-64-hex
SESSION_SECRET=CAMBIAR-64-hex
MICROSOFT_CRYPTO_KEY=CAMBIAR-64-hex
CURRENCY=MXN

# --- Orígenes públicos ---
# VPS (Cloudflare): https://crm.edrs.xyz
# Bare: https://<tu-dominio>
FRONTEND_URL=https://crm.edrs.xyz
CORS_ORIGIN=https://crm.edrs.xyz
GRAPH_PUBLIC_URL=https://crm.edrs.xyz

# --- Solo bare-server (edge Caddy): dominio desnudo sin protocolo ---
# DOMAIN=crm.ejemplo.com

# --- SMTP (vacío = dry-run, los correos solo se loguean) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
